nt-weight: 800;       letter-spacing: -0.5px;       margin-bottom: 0.4rem;     }      header p {       font-size: 0.95rem;       color: #ecfdf5;       font-weight: 500;     }      main {       max-width: 680px;       margin: -1.5rem auto 0;       padding: 0 1rem;     }      .form-card {       background: var(--card);       border-radius: var(--radius);       padding: 1.4rem;       box-shadow: var(--shadow);       border: 1px solid var(--border);       margin-bottom: 1.2rem;     }      .section-title {       font-size: 1.05rem;       font-weight: 700;       color: #0f172a;       display: flex;       align-items: center;       gap: 0.5rem;       margin-bottom: 1rem;       border-bottom: 1.5px solid #f1f5f9;       padding-bottom: 0.5rem;     }      .field-group {       margin-bottom: 1.1rem;     }      .field-group:last-child {       margin-bottom: 0;     }      label {       display: block;       font-size: 0.85rem;       font-weight: 600;       color: #334155;       margin-bottom: 0.45rem;     }      .chip-grid {       display: grid;       grid-template-columns: repeat(auto-fit, minmax(95px, 1fr));       gap: 0.5rem;     }      .chip-grid.dense {       grid-template-columns: repeat(auto-fit, minmax(70px, 1fr));     }      .chip {       position: relative;     }      .chip input[type="radio"],     .chip input[type="checkbox"] {       position: absolute;       opacity: 0;       pointer-events: none;     }      .chip label {       display: flex;       flex-direction: column;       align-items: center;       justify-content: center;       text-align: center;       background: #f8fafc;       border: 1.5px solid #e2e8f0;       border-radius: 12px;       padding: 0.6rem 0.4rem;       font-size: 0.82rem;       font-weight: 600;       cursor: pointer;       transition: all 0.15s ease-in-out;       min-height: 44px;       margin-bottom: 0;       color: #475569;     }      .chip input:checked + label {       background: var(--primary-light);       border-color: var(--primary);       color: #065f46;       box-shadow: 0 0 0 1px var(--primary);     }      .sub-nv {       background: #fffbeb;       border: 1px dashed #f59e0b;       padding: 0.8rem;       border-radius: 12px;       margin-top: 0.6rem;       display: none;     }      .text-input, select {       width: 100%;       padding: 0.75rem 0.9rem;       border: 1.5px solid var(--border);       border-radius: 12px;       font-size: 0.9rem;       background-color: #fff;       color: #1e293b;       transition: border-color 0.15s;     }      .text-input:focus, select:focus {       outline: none;       border-color: var(--primary);     }      .submit-btn {       width: 100%;       background: linear-gradient(135deg, #10b981 0%, #059669 100%);       color: white;       border: none;       border-radius: 16px;       padding: 1.1rem;       font-size: 1.1rem;       font-weight: 700;       cursor: pointer;       box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);       transition: transform 0.1s ease, filter 0.2s ease;       display: flex;       align-items: center;       justify-content: center;       gap: 0.5rem;     }      .submit-btn:active {       transform: scale(0.98);       filter: brightness(0.95);     }      /* Results Dashboard */     #results-area {       display: none;       margin-top: 1.5rem;       animation: fadeIn 0.4s ease-out;     }      @keyframes fadeIn {       from { opacity: 0; transform: translateY(12px); }       to { opacity: 1; transform: translateY(0); }     }      .metrics-summary-grid {       display: grid;       grid-template-columns: repeat(2, 1fr);       gap: 0.75rem;       margin-bottom: 1.2rem;     }      .metric-card {       background: white;       padding: 1rem;       border-radius: 16px;       border: 1px solid var(--border);       box-shadow: var(--shadow);     }      .metric-card.full-width {       grid-column: span 2;     }      .metric-title {       font-size: 0.75rem;       text-transform: uppercase;       font-weight: 700;       letter-spacing: 0.5px;       color: var(--text-muted);       margin-bottom: 0.2rem;     }      .metric-val {       font-size: 1.35rem;       font-weight: 800;       color: #0f172a;     }      .metric-sub {       font-size: 0.75rem;       color: var(--text-muted);       margin-top: 0.2rem;     }      .day-selector {       display: flex;       gap: 0.4rem;       overflow-x: auto;       padding-bottom: 0.6rem;       margin-bottom: 1rem;       -webkit-overflow-scrolling: touch;     }      .day-tab {       flex: 0 0 auto;       padding: 0.5rem 0.9rem;       border-radius: 999px;       background: white;       border: 1.5px solid var(--border);       font-size: 0.8rem;       font-weight: 700;       cursor: pointer;       color: #475569;     }      .day-tab.active {       background: #0f172a;       color: white;       border-color: #0f172a;     }      .meal-block {       background: white;       border-radius: 14px;       border: 1px solid var(--border);       margin-bottom: 0.75rem;       overflow: hidden;     }      .meal-header {       background: #f8fafc;       padding: 0.65rem 0.9rem;       font-size: 0.88rem;       font-weight: 700;       color: #1e293b;       display: flex;       justify-content: space-between;       align-items: center;       border-bottom: 1px solid #f1f5f9;     }      .meal-item {       padding: 0.75rem 0.9rem;       border-bottom: 1px solid #f8fafc;       display: flex;       justify-content: space-between;       align-items: flex-start;       gap: 0.5rem;     }      .meal-item:last-child {       border-bottom: none;     }      .item-name {       font-weight: 700;       font-size: 0.95rem;       color: #0f172a;     }      .item-qty {       font-size: 0.8rem;       color: #059669;       font-weight: 600;     }      .item-macros {       font-size: 0.76rem;       color: var(--text-muted);       margin-top: 0.15rem;     }      .item-cost-edit {       display: flex;       align-items: center;       gap: 0.2rem;       background: #f1f5f9;       padding: 0.2rem 0.4rem;       border-radius: 8px;     }      .cost-input {       width: 44px;       border: none;       background: transparent;       font-weight: 700;       font-size: 0.85rem;       text-align: right;       color: #0f172a;     }      .cost-input:focus {       outline: none;       background: white;       border-radius: 4px;     }      .daily-summary-box {       background: #f0fdf4;       border: 1.5px solid #bbf7d0;       border-radius: 14px;       padding: 0.85rem;       margin-top: 1rem;     }      .summary-title {       font-size: 0.85rem;       font-weight: 700;       color: #166534;       margin-bottom: 0.5rem;     }      .summary-stats {       display: grid;       grid-template-columns: repeat(4, 1fr);       gap: 0.4rem;       text-align: center;     }      .summary-stat-val {       font-size: 0.95rem;       font-weight: 800;       color: #15803d;     }      .summary-stat-lbl {       font-size: 0.7rem;       color: #166534;     }      .night-routine-banner {       background: #f5f3ff;       border: 1px solid #ddd6fe;       border-radius: 12px;       padding: 0.75rem;       margin-top: 0.75rem;       font-size: 0.8rem;       color: #5b21b6;     }      .note-box {       font-size: 0.76rem;       color: #64748b;       margin-top: 0.4rem;       line-height: 1.4;     }      .budget-diff-pill {       display: inline-block;       padding: 0.2rem 0.6rem;       border-radius: 999px;       font-size: 0.75rem;       font-weight: 700;       margin-top: 0.4rem;     }      .diff-under {       background: #dcfce7;       color: #15803d;     }      .diff-over {       background: #fee2e2;       color: #b91c1c;     }   </style> </head> <body>    <header>     <div class="header-badge">🌿 AI NUTRITION ENGINE</div>     <h1>🥗 PERSONAL DIET PLANNER</h1>     <p class="telugu-font">"మీ వివరాలకు తగ్గట్టు మీ Personalized Diet Plan"</p>   </header>    <main>     <form id="dietForm">              <!-- 1. PERSONAL DETAILS -->       <section class="form-card">         <h2 class="section-title">👤 Personal Details (వ్యక్తిగత వివరాలు)</h2>                  <div class="field-group">           <label>Gender (లింగం)</label>           <div class="chip-grid">             <div class="chip">               <input type="radio" id="g_male" name="gender" value="male" checked>               <label for="g_male">Male</label>             </div>             <div class="chip">               <input type="radio" id="g_female" name="gender" value="female">               <label for="g_female">Female</label>             </div>           </div>         </div>          <div class="field-group">           <label>Age (వయస్సు)</label>           <div class="chip-grid dense">             <div class="chip"><input type="radio" id="age1" name="age" value="21" checked><label for="age1">18–25</label></div>             <div class="chip"><input type="radio" id="age2" name="age" value="28"><label for="age2">26–30</label></div>             <div class="chip"><input type="radio" id="age3" name="age" value="33"><label for="age3">31–35</label></div>             <div class="chip"><input type="radio" id="age4" name="age" value="38"><label for="age4">36–40</label></div>             <div class="chip"><input type="radio" id="age5" name="age" value="45"><label for="age5">41–50</label></div>             <div class="chip"><input type="radio" id="age6" name="age" value="55"><label for="age6">51–60</label></div>             <div class="chip"><input type="radio" id="age7" name="age" value="65"><label for="age7">60+</label></div>           </div>         </div>          <div class="field-group">           <label>Height (ఎత్తు)</label>           <div class="chip-grid">             <div class="chip"><input type="radio" id="h1" name="height" value="148"><label for="h1">&lt; 5 ft</label></div>             <div class="chip"><input type="radio" id="h2" name="height" value="157"><label for="h2">5'0–5'3</label></div>             <div class="chip"><input type="radio" id="h3" name="height" value="165" checked><label for="h3">5'4–5'6</label></div>             <div class="chip"><input type="radio" id="h4" name="height" value="173"><label for="h4">5'7–5'9</label></div>             <div class="chip"><input type="radio" id="h5" name="height" value="180"><label for="h5">5'10–6'0</label></div>             <div class="chip"><input type="radio" id="h6" name="height" value="188"><label for="h6">&gt; 6 ft</label></div>           </div>         </div>          <div class="field-group">           <label>Weight (బరువు)</label>           <div class="chip-grid dense">             <div class="chip"><input type="radio" id="w1" name="weight" value="48"><label for="w1">&lt; 50 kg</label></div>             <div class="chip"><input type="radio" id="w2" name="weight" value="55"><label for="w2">50–59</label></div>             <div class="chip"><input type="radio" id="w3" name="weight" value="65" checked><label for="w3">60–69</label></div>             <div class="chip"><input type="radio" id="w4" name="weight" value="75"><label for="w4">70–79</label></div>             <div class="chip"><input type="radio" id="w5" name="weight" value="85"><label for="w5">80–89</label></div>             <div class="chip"><input type="radio" id="w6" name="weight" value="95"><label for="w6">90–99</label></div>             <div class="chip"><input type="radio" id="w7" name="weight" value="105"><label for="w7">100–109</label></div>             <div class="chip"><input type="radio" id="w8" name="weight" value="115"><label for="w8">110+ kg</label></div>           </div>         </div>       </section>        <!-- 2. GOAL & DIET PREFERENCES -->       <section class="form-card">         <h2 class="section-title">🎯 Goal & Food Type</h2>                  <div class="field-group">           <label>Primary Goal (లక్ష్యం)</label>           <div class="chip-grid">             <div class="chip"><input type="radio" id="g1" name="goal" value="loss" checked><label for="g1">Weight Loss</label></div>             <div class="chip"><input type="radio" id="g2" name="goal" value="muscle"><label for="g2">Muscle Building</label></div>             <div class="chip"><input type="radio" id="g3" name="goal" value="recomp"><label for="g3">Weight Loss + Muscle</label></div>             <div class="chip"><input type="radio" id="g4" name="goal" value="gain"><label for="g4">Weight Gain</label></div>             <div class="chip"><input type="radio" id="g5" name="goal" value="maintain"><label for="g5">Healthy Lifestyle</label></div>           </div>         </div>          <div class="field-group">           <label>Food Type (ఆహార విధానం)</label>           <div class="chip-grid">             <div class="chip"><input type="radio" id="ft1" name="food_type" value="veg"><label for="ft1">Vegetarian</label></div>             <div class="chip"><input type="radio" id="ft2" name="food_type" value="nonveg" checked><label for="ft2">Non-Vegetarian</label></div>             <div class="chip"><input type="radio" id="ft3" name="food_type" value="eggetarian"><label for="ft3">Eggetarian</label></div>             <div class="chip"><input type="radio" id="ft4" name="food_type" value="vegan"><label for="ft4">Vegan</label></div>           </div>            <div id="nv_options" class="sub-nv">             <label style="color: #92400e;">Allow Non-Veg Options (ఎంచుకోండి):</label>             <div class="chip-grid dense">               <div class="chip"><input type="checkbox" id="nv_chk" name="nv_items" value="chicken" checked><label for="nv_chk">🍗 Chicken</label></div>               <div class="chip"><input type="checkbox" id="nv_egg" name="nv_items" value="eggs" checked><label for="nv_egg">🥚 Eggs</label></div>               <div class="chip"><input type="checkbox" id="nv_fish" name="nv_items" value="fish" checked><label for="nv_fish">🐟 Fish</label></div>               <div class="chip"><input type="checkbox" id="nv_mut" name="nv_items" value="mutton"><label for="nv_mut">🥩 Mutton</label></div>             </div>           </div>         </div>          <div